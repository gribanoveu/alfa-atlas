{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* The `asciidoctor` package's package.json exports field maps `.` to
       ./index.js without a `types` entry, so moduleResolution "bundler"
       cannot find its bundled .d.ts. Map the package to its type
       definitions directly. */
    "paths": {
      "asciidoctor": ["./node_modules/asciidoctor/types/index"]
    }
  },
  "include": ["src", "app.config.json"],
  "exclude": ["src/__tests__/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
