{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/.alfa-atlas" },
        { "path": "$HOME/.alfa-atlas/**" },
        { "path": "**" }
      ]
    },
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "mcp-bridge:default"
  ]
}
